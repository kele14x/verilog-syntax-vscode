{
  "name": "verilog-syntax",
  "displayName": "Verilog / SystemVerilog Syntax",
  "description": "Lightweight Verilog and SystemVerilog syntax highlighting, including assertions, with no language server or external tools.",
  "version": "0.1.1",
  "publisher": "kele14x",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Michiru Morishita",
    "url": "https://github.com/kele14x"
  },
  "homepage": "https://github.com/kele14x/verilog-syntax-vscode#readme",
  "bugs": {
    "url": "https://github.com/kele14x/verilog-syntax-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kele14x/verilog-syntax-vscode.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "verilog",
    "systemverilog",
    "syntax highlighting",
    "rtl",
    "hdl",
    "fpga"
  ],
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": ["Verilog", "verilog"],
        "extensions": [".v", ".vh", ".vl"]
      },
      {
        "id": "systemverilog",
        "aliases": ["SystemVerilog", "System Verilog", "systemverilog"],
        "extensions": [".sv", ".svh", ".SV"]
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "vscode:prepublish": "npm test",
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies",
    "preview": "vscode-test-web --browser none --quality stable --host localhost --port 9321 --extensionDevelopmentPath . examples"
  },
  "devDependencies": {
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
